# Database — use Docker Compose defaults locally; rotate for any shared deploy
DATABASE_URL=postgresql://eldercare:CHANGE_ME@localhost:5432/eldercare

# Ollama — local only; user intake must never go to hosted LLM APIs
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# M2 telephony (leave blank until Milestone 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
PUBLIC_WEBSOCKET_URL=

# Feature flags
ENABLE_TRANSCRIPT_PERSISTENCE=true
TRANSCRIPT_RETENTION_DAYS=7
REDACT_LOGS=true
